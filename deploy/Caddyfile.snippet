# --- Drive (DINUM x 42) : bloc a coller dans /srv/caddy/conf/Caddyfile ---
# Les quatre noms sont ceux de deploy/.env. Chacun doit avoir un
# enregistrement A vers ce serveur avant que Caddy puisse obtenir son
# certificat : un seul joker (*) suffit, les quatre sont au meme niveau.
drive.BASE {
	encode zstd gzip
	reverse_proxy drive-prod-nginx:80
}

auth.BASE {
	reverse_proxy drive-prod-keycloak:8080
}

office.BASE {
	reverse_proxy drive-prod-onlyoffice:80
}

s3.BASE {
	request_body {
		max_size 5GB
	}
	reverse_proxy drive-prod-minio:9000
}
